      "parameters": {
        "jsCode": "const status = $input.first().json;\nif (status.status_code !== 'FINISHED') {\n  throw new Error(\n    'Container Instagram belum siap. Status: ' +\n    String(status.status_code ?? status.status ?? 'UNKNOWN') +\n    '. Periksa URL gambar dan jalankan ulang workflow.'\n  );\n}\nreturn [{ json: status }];"
      },
