    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst raw = String(input['Username Instagram'] ?? input['Akun sosmed'] ?? input.instagram_username ?? '').trim();\nconst username = raw.replace(/^@+/, '').toLowerCase();\n\nif (!/^[a-z0-9._]{1,30}$/.test(username)) {\n  throw new Error('Username Instagram tidak valid. Gunakan 1-30 karakter: huruf, angka, titik, atau underscore.');\n}\n\nconst consentRaw = input['Persetujuan mention Instagram'];\nconst consentText = Array.isArray(consentRaw)\n  ? consentRaw.join(' ').trim().toLowerCase()\n  : String(consentRaw ?? '').trim().toLowerCase();\nconst consent = consentRaw === true\n  || (Array.isArray(consentRaw) && consentRaw.length > 0)\n  || ['ya', 'yes', 'true', '1', 'setuju', 'on'].some((value) => consentText.includes(value));\n\nif (!consent) {\n  throw new Error('Persetujuan mention Instagram wajib diberikan sebelum posting.');\n}\n\nconst imageUrl = 'https://grandivo.com/wp-content/uploads/2025/09/GDV.jpg';\nconst caption = `Terima kasih @${username} sudah menjadi bagian dari Sobat Grandivo! 🎉\n\nTemukan gadget dan elektronik pilihanmu di grandivo.com.\n\n#Grandivo #SobatGrandivo`;\n\nreturn [{\n  json: {\n    ...input,\n    instagram_username: username,\n    instagram_handle: `@${username}`,\n    image_url: imageUrl,\n    caption,\n  },\n}];"
      },
