    {
      "parameters": {
        "jsCode": "const status = $input.first().json;\nif (status.status_code !== 'FINISHED') {\n  throw new Error('Container Instagram belum siap. Status: ' + String(status.status_code ?? status.status ?? 'UNKNOWN') + '. Jalankan ulang setelah memeriksa URL gambar.');\n}\nreturn [{ json: status }];"
      },
