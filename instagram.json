      "name": "On form submission"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst name = String(input.Nama ?? input.name ?? '').trim();\nif (!name) {\n  throw new Error('Nama pelanggan wajib diisi.');\n}\n\nconst phoneRaw = String(input['Nomor telepon'] ?? input.phone ?? '').trim();\nconst phone = phoneRaw.replace(/[^\\d+]/g, '');\nif (!/^\\+?\\d{8,15}$/.test(phone)) {\n  throw new Error('Nomor telepon tidak valid. Gunakan 8-15 digit dan boleh diawali tanda +.');\n}\n\nconst rawUsername = String(\n  input['Username Instagram'] ?? input['Akun sosmed'] ?? input.instagram_username ?? ''\n).trim();\nconst username = rawUsername.replace(/^@+/, '').toLowerCase();\n\nif (!/^[a-z0-9._]{1,30}$/.test(username)) {\n  throw new Error(\n    'Username Instagram tidak valid. Gunakan 1-30 karakter: huruf, angka, titik, atau underscore.'\n  );\n}\n\nconst consentRaw = input['Persetujuan mention Instagram'];\nconst consentText = Array.isArray(consentRaw)\n  ? consentRaw.join(' ').trim().toLowerCase()\n  : String(consentRaw ?? '').trim().toLowerCase();\n\nconst consent = consentRaw === true\n  || (Array.isArray(consentRaw) && consentRaw.length > 0)\n  || ['ya', 'yes', 'true', '1', 'setuju', 'on'].some((value) => consentText.includes(value));\n\nif (!consent) {\n  throw new Error('Persetujuan mention Instagram wajib diberikan sebelum posting.');\n}\n\nconst consentAt = new Date().toISOString();\nconst imageUrl = 'https://grandivo.com/wp-content/uploads/2025/09/GDV.jpg';\nconst caption = `Terima kasih @${username} sudah menjadi bagian dari Sobat Grandivo! 🎉\n\nTemukan gadget dan elektronik pilihanmu di grandivo.com.\n\n#Grandivo #SobatGrandivo`;\n\nreturn [{\n  json: {\n    customer_name: name,\n    phone_number: phone,\n    instagram_username: username,\n    instagram_handle: `@${username}`,\n    consent: true,\n    consent_at: consentAt,\n    image_url: imageUrl,\n    caption,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        352,
